# Local-only development needs no variables. Do not commit real keys or a
# connection string. Vite's dev server alone does not run the /api functions.
#
# Neon sync: use the pooled connection string in Vercel's server-side
# environment, then set VITE_SYNC_MODE=neon at build time and redeploy.
# Existing task snapshots remain the authoritative task database. The
# idempotent schema in db/neon-schema.sql is also applied on first API use.
DATABASE_URL=
VITE_SYNC_MODE=

# Background Web Push (server-side only; never prefix these with VITE_).
# Generate a stable, unique key pair with: npx web-push generate-vapid-keys
# Store the private key as a secret. Changing it invalidates existing browser
# subscriptions, and each device will need to enable notifications again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI controlled by the deployment owner, e.g. mailto:owner@example.com
VAPID_SUBJECT=

# A random secret at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Configure your scheduler to call GET /api/cron/reminders every minute with
# Authorization: Bearer <CRON_SECRET>. See README for Vercel and external options.
CRON_SECRET=
