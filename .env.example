# Sync for My Workday Planner. Leave everything blank and the planner is purely
# local: no account leaves the device, nothing is uploaded.
#
# ---------------------------------------------------------------------------
# Option A — Neon (a database plus the small API in /api, no third party auth)
# ---------------------------------------------------------------------------
# 1. Create a project at neon.com (free plan). Region: AWS ap-southeast-1
#    (Singapore) is the closest Neon offers to India.
# 2. Open the SQL editor and run db/neon-schema.sql once.
# 3. Copy the pooled connection string from Connection Details.
# 4. Fill both values below and redeploy. Every device then syncs with nothing
#    to paste — sign up on the laptop, sign in on the phone.
#
# DATABASE_URL is server-side only: it is read by api/*, never shipped to the
# browser. Do not prefix it with VITE_.
DATABASE_URL=
VITE_SYNC_MODE=

# ---------------------------------------------------------------------------
# Option B — Supabase (database + built-in auth; see supabase/schema.sql)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
